# Server-side Google Gemini API key (never commit the real one)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides. Leave unset to use the defaults in lib/config.ts
# GEMINI_MODEL=            # forces one model for both Quick and Deep
# GEMINI_MODEL_QUICK=gemini-flash-lite-latest
# GEMINI_MODEL_DEEP=gemini-flash-latest
